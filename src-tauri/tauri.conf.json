{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vitro Tasks",
  "version": "0.9.3",
  "identifier": "app.vitro.tasks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vitro Tasks",
        "width": 1320,
        "height": 860,
        "minWidth": 300,
        "minHeight": 400,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "quickadd",
        "title": "Vitro Quick Add",
        "url": "index.html",
        "width": 680,
        "height": 92,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0NzUwOThFMEY4OTMxRTAKUldUZ01Za1BqZ2wxQlBLenNEZFdNb3c2Q2gwZSt5UXMxN1hzY3dCelRTSHozNU54YmxpTVNlZVIK",
      "endpoints": [
        "https://github.com/pad-mac/Vitro-Tasks/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
