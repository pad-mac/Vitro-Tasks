{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What every app window may do, on desktop and on iOS.",
  "windows": [
    "main",
    "quickadd",
    "view-*"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "zotero:*" },
        { "url": "obsidian:*" },
        { "url": "notion:*" },
        { "url": "things:*" },
        { "url": "x-devonthink-item:*" },
        { "url": "onenote:*" },
        { "url": "tel:*" },
        { "url": "sms:*" },
        { "url": "facetime:*" }
      ]
    },
    "dialog:allow-save",
    "core:event:allow-emit-to"
  ]
}
